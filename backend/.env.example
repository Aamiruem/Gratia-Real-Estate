# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.
# Everything is optional for local development: with an empty file the backend
# uses SQLite, generates JWT secrets and prints OTP codes in the terminal.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production). URL-encode special characters in
# the password (@ becomes %40). Leave empty locally to use backend/gratia.db.
# This SQLAlchemy backend does not accept a MongoDB Atlas URI.
DATABASE_URL=
# Only used by backend/docker-compose.yml when it creates a local Postgres.
POSTGRES_DB=gratia
POSTGRES_USER=gratia
POSTGRES_PASSWORD=
# ── Sessions ────────────────────────────────────────────────────────────────
# Leave blank for local development; the backend creates strong secrets in backend/.env.
# Render generates these in the hosting environment from render.yaml.
# If deploying elsewhere, generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# true when served over HTTPS (production). Also turns off dev OTP fallbacks.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Extra browser origins allowed to call the API directly (comma-separated).
# Not needed when the site calls it through /api (the default).
FRONTEND_ORIGINS=

# ── Owner ───────────────────────────────────────────────────────────────────
# The only email and mobile number that can sign in and manage videos.
VIDEO_ADMIN_EMAIL=owner@example.com
OWNER_PHONE_NUMBER=+91XXXXXXXXXX

# ── Email OTP ───────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp | resend  (auto-detected from the keys below if empty)
EMAIL_PROVIDER=

# Option A: SMTP. Gmail needs 2-Step Verification + an App Password
# (Google Account → Security → App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gratia Estates <you@gmail.com>

# Option B: Resend (https://resend.com) – HTTPS API, works where SMTP is blocked.
RESEND_API_KEY=
EMAIL_FROM=Gratia Estates <otp@yourdomain.com>

# ── Mobile OTP (SMS) ────────────────────────────────────────────────────────
# SMS_PROVIDER=twilio | msg91 | fast2sms  (auto-detected if empty)
# Fast2SMS is used by the Render deployment for Indian mobile numbers.
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=

# Twilio alternative. Set SMS_PROVIDER=twilio to use these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Alternatives for India:

# MSG91 (India): create a DLT-approved OTP template with variable ##otp##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp

# ── WhatsApp OTP (Meta Cloud API) ────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_BUTTON=true


# Public website address, used for links in owner lead alerts (ntfy).
PUBLIC_SITE_URL=https://www.gratiaestates.com

# ── Optional owner alerts: phone push notification via the free ntfy app ────
# Used for new website lead alerts only, never for sign-in OTP delivery.
# Use a long random topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ── Browser push notifications (optional) ──────────────────────────────────
# Generate a key pair with:  python -m app.push   (run inside backend/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ── AI chat assistant (optional, OpenAI / ChatGPT API) ─────────────────────
# Create a key at https://platform.openai.com/api-keys (billed per use; a
# ChatGPT Business subscription does not include API usage).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Sitemap refresh after property changes (optional) ──────────────────────
# Vercel → Project → Settings → Git → Deploy Hooks → create, paste the URL.
VERCEL_DEPLOY_HOOK_URL=
