# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.
# Everything is optional for local development: with an empty file the backend
# uses SQLite, generates JWT secrets and prints OTP codes in the terminal.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production). URL-encode special characters in
# the password (@ becomes %40). Leave empty locally to use backend/gratia.db.
DATABASE_URL=
# Only used by backend/docker-compose.yml when it creates a local Postgres.
POSTGRES_DB=gratia
POSTGRES_USER=gratia
POSTGRES_PASSWORD=

# ── Sessions ────────────────────────────────────────────────────────────────
# Required in production. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# true when served over HTTPS (production). Also turns off dev OTP fallbacks.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Extra browser origins allowed to call the API directly (comma-separated).
# Not needed when the site calls it through /api (the default).
FRONTEND_ORIGINS=

# ── Owner ───────────────────────────────────────────────────────────────────
# The only email and mobile number that can sign in and manage videos.
VIDEO_ADMIN_EMAIL=owner@example.com
OWNER_PHONE_NUMBER=+91XXXXXXXXXX

# ── Email OTP ───────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp | resend  (auto-detected from the keys below if empty)
EMAIL_PROVIDER=

# Option A: SMTP. Gmail needs 2-Step Verification + an App Password
# (Google Account → Security → App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gratia Estates <you@gmail.com>

# Option B: Resend (https://resend.com) – HTTPS API, works where SMTP is blocked.
RESEND_API_KEY=
EMAIL_FROM=Gratia Estates <otp@yourdomain.com>

# ── Mobile OTP (SMS) ────────────────────────────────────────────────────────
# SMS_PROVIDER=twilio | msg91 | fast2sms  (auto-detected if empty)
# This site uses Twilio. Keys: Twilio Console → Account Info. On a trial
# account, OWNER_PHONE_NUMBER must be added under Verified Caller IDs.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=

# Alternatives for India:

# MSG91 (India): create a DLT-approved OTP template with variable ##otp##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp

# Fast2SMS (India): OTP route API key
FAST2SMS_API_KEY=


# ── Optional backup: phone push notification via the free ntfy app ─────────
# Use a long random topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
