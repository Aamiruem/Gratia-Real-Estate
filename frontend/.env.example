# Local development: the Vite dev server proxies /api to this backend.
DEV_BACKEND_URL=http://127.0.0.1:8000

# Optional: call a backend on another origin directly instead of /api.
# Leave empty in almost all cases (cookies need same-site requests).
# VITE_API_URL=

# Public site address used for SEO (sitemap, canonical links).
# SITE_URL=https://www.gratiaestates.com

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Loaded only after a visitor
# accepts analytics cookies. Set it in Vercel → Settings → Environment Variables.
VITE_GA_MEASUREMENT_ID=

# Google Identity Services Web Client ID (use the same value as
# GOOGLE_OAUTH_CLIENT_ID in the backend environment).
VITE_GOOGLE_CLIENT_ID=

# Used at build time to put live (admin-panel) listings into the sitemap.
# In Vercel this is the same BACKEND_URL the /api proxy uses.
# BACKEND_URL=https://gratia-api.onrender.com
