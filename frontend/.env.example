# Local development: the Vite dev server proxies /api to this backend.
DEV_BACKEND_URL=http://127.0.0.1:8000

# Optional: call a backend on another origin directly instead of /api.
# Leave empty in almost all cases (cookies need same-site requests).
# VITE_API_URL=

# Public site address used for SEO (sitemap, canonical links).
# SITE_URL=https://www.gratiaestates.com
